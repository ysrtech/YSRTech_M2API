<?xml version="1.0"?>
<config>
    <sections>
        <ysrtech_m2api translate="label" module="ysrtech_m2api">
            <label>M2 API</label>
            <tab>service</tab>
            <frontend_type>text</frontend_type>
            <sort_order>150</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <auth translate="label comment" module="ysrtech_m2api">
                    <label>Authentication</label>
                    <comment>Long-lived API keys for integrations (e.g. ShipStation) are managed under System &gt; M2 API Keys.</comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <secret translate="label comment" module="ysrtech_m2api">
                            <label>Token Signing Secret</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <comment>Signs the short-lived tokens issued by the username/password endpoints. Generated automatically on install. Changing it invalidates every token issued so far; API keys are not affected.</comment>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </secret>
                        <token_ttl translate="label comment" module="ysrtech_m2api">
                            <label>Password Token Lifetime (seconds)</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <comment>How long a token from /rest/V1/integration/admin/token or /rest/V1/integration/customer/token stays valid. Default 86400 (24 hours).</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </token_ttl>
                    </fields>
                </auth>
            </groups>
        </ysrtech_m2api>
    </sections>
</config>
