<?xml version="1.0"?>
<config>
    <sections>
        <ysrtech_m2api translate="label" module="ysrtech_m2api">
            <label>M2 API</label>
            <tab>service</tab>
            <frontend_type>text</frontend_type>
            <sort_order>150</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <auth translate="label comment" module="ysrtech_m2api">
                    <label>Authentication</label>
                    <comment>Long-lived API keys for integrations (e.g. ShipStation) are managed under System &gt; M2 API Keys. Password-issued tokens are signed with a key derived from this install's encryption key; rotating it under System &gt; Manage Encryption Key invalidates outstanding tokens.</comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <token_ttl translate="label comment" module="ysrtech_m2api">
                            <label>Password Token Lifetime (seconds)</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <comment>How long a token from /rest/V1/integration/admin/token or /rest/V1/integration/customer/token stays valid. Default 86400 (24 hours).</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </token_ttl>
                    </fields>
                </auth>
                <logging translate="label comment" module="ysrtech_m2api">
                    <label>Logging</label>
                    <comment>Writes request logs to var/log/m2api.log (REST), var/log/m2api_auctane.log (ShipStation) and var/log/m2api_all_requests.log (router; every request on the site, matched or not). Leave off in production unless you are debugging an integration.</comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>20</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label" module="ysrtech_m2api">
                            <label>Enable Debug Logging</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                    </fields>
                </logging>
            </groups>
        </ysrtech_m2api>
    </sections>
</config>
